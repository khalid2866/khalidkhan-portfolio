# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to a public repository.

# Port the API server runs on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Add your live domain here once you deploy the frontend.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Email (Gmail) ---
# 1. Turn on 2-Step Verification on Khalidabbaskhan527@gmail.com
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Paste that 16-character app password below (NOT your normal Gmail password)
EMAIL_USER=Khalidabbaskhan527@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_TO=Khalidabbaskhan527@gmail.com

# --- Admin ---
# Simple key to view submitted messages at GET /api/messages?key=YOUR_KEY
ADMIN_KEY=change-this-to-a-long-random-string
